# ==========================================
# 4. 基础设施 / 数据存储 (Docker, Milvus, Postgres)
# ==========================================
# 忽略 Postgres 初始数据挂载目录中的实际数据文件（保留 init 目录下的初始化脚本）
deploy/postgres/data/
deploy/postgres/pgdata/

# 忽略 Milvus 运行时生成的数据、日志与挂载卷
deploy/milvus/data/
deploy/milvus/logs/

# 通用 Docker 挂载数据
**/data/raw/*
!**/data/raw/.gitkeep
data/db/
*.sqlite3
*.db

